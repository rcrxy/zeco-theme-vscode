{
    "name": "zeco-theme",
    "displayName": "Zeco Theme",
    "description": "A carefully tuned color theme for Visual Studio Code.",
    "author": {
        "name": "zeco"
    },
    "publisher": "zeco",
    "version": "0.1.5",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark",
        "color-theme",
        "syntax-highlighting",
        "zeco"
    ],
    "galleryBanner": {
        "color": "#1F1F1F",
        "theme": "dark"
    },
    "contributes": {
        "themes": [
            {
                "label": "Zeco Theme Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/dark.json"
            }
        ]
    },
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/rcrxy/zeco-theme-vscode.git"
    },
    "scripts": {
        "validate": "vsce ls",
        "vsix": "vsce package",
        "publish:marketplace": "vsce publish",
        "minor": "npm version --no-git-tag-version minor",
        "patch": "npm version --no-git-tag-version patch"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.9.2"
    }
}
